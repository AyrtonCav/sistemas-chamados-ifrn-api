# ============================================
# Configurações do Banco de Dados (Opcional)
# ============================================
# Copie este arquivo para .env se quiser sobrescrever os padrões.
# Se não criar o .env, o docker-compose usará valores padrão.

# Onde o banco está rodando?
DB_HOST=localhost

# Porta exposta pelo Docker
DB_PORT=5432

# Credenciais do Banco
DB_NAME=chamados
DB_USER=admin
DB_PASSWORD=

# Docker
POSTGRES_CONTAINER_NAME=postgres_chamados_db